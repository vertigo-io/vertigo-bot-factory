package io.vertigo.chatbot.designer.builder.questionAnswer

create Task TkGetAllQuestionAnswerIhmFromBot {
    className : "io.vertigo.basics.task.TaskEngineSelect"
    request : "
			SELECT 	qa.qa_id,
					qa.question,
					qa.answer,
					qa.is_enabled,
					qa.code,
					qa.sequence,
					qac.qa_cat_id as cat_id,
					qac.label as cat_label
			from question_answer qa
			join question_answer_category qac on (qac.qa_cat_id = qa.qa_cat_id)
			where qa.bot_id = #botId#
			order by qac.sequence,
                    qa.sequence
             "

	in botId  				{domain : DoId         		        cardinality : "1"  }
	out questionanswerIHM   {domain : DoDtQuestionAnswerIhm 	cardinality : "*"  }
}
create Task TkGetQuestionAnswerIhmById {
    className : "io.vertigo.basics.task.TaskEngineSelect"
    request : "
			SELECT 	qa.qa_id,
                    qa.question,
                    qa.answer,
                    qa.is_enabled,
                    qa.code,
                    qa.sequence,
                    qac.qa_cat_id as cat_id,
                    qac.label as cat_label
			from question_answer qa
            join question_answer_category qac on (qac.qa_cat_id = qa.qa_cat_id)
			where qa.qa_id = #qaId#

			LIMIT 1
             "
	in qaId  				{domain : DoId         		        cardinality : "1"  }
	out questionAnswerIHM   {domain : DoDtQuestionAnswerIhm		cardinality : "1"  }
}

/********** Question-Answer Category ordering **********/

create Task TkFindQueAnsCatPreviousNeighbor {
    className : "io.vertigo.basics.task.TaskEngineSelect"
    request : "
			SELECT 	qac.*
			from question_answer_category qac
			where qac.bot_id = #botId# and qac.sequence < #sequence#
			order by qac.sequence desc
			limit 1
             "
	in botId  				{domain : DoId         		        cardinality : "1"  }
	in sequence  			{domain : DoNumber         		    cardinality : "1"  }
	out category            {domain : DoDtQuestionAnswerCategory cardinality : "1"  }
}

create Task TkFindQueAnsCatNextNeighbor {
    className : "io.vertigo.basics.task.TaskEngineSelect"
    request : "
			SELECT 	qac.*
			from question_answer_category qac
			where qac.bot_id = #botId# and qac.sequence > #sequence#
			order by qac.sequence asc
			limit 1
             "
	in botId  				{domain : DoId         		        cardinality : "1"  }
	in sequence  			{domain : DoNumber         		    cardinality : "1"  }
	out category            {domain : DoDtQuestionAnswerCategory cardinality : "1"  }
}

create Task TkGetNextQueAnsCatSequence {
    className : "io.vertigo.basics.task.TaskEngineSelect"
    request : "
			select coalesce(max(sequence) + 1, 1)
			from question_answer_category qac
			where qac.bot_id = #botId#
             "
	in botId  				          {domain : DoId         	cardinality : "1"  }
	out nextQueAnsCatSequence         {domain : DoNumber         cardinality : "1"  }
}

create Task TkReorderQueAnsCatAfterDelete {
    className : "io.vertigo.basics.task.TaskEngineProc"
    request : "
			update question_answer_category
			set sequence = (sequence - 1)
			where bot_id = #botId# and sequence > #deletedSequence#
             "
	in botId  				          {domain : DoId         	cardinality : "1"  }
	in deletedSequence  			  {domain : DoNumber         cardinality : "1"  }
}

/********** Question-Answer ordering **********/

create Task TkFindQueAnsPreviousNeighbor {
    className : "io.vertigo.basics.task.TaskEngineSelect"
    request : "
			SELECT 	qa.*
			from question_answer qa
			where qa.qa_cat_id = #qaCatId# and qa.sequence < #sequence#
			order by qa.sequence desc
			limit 1
             "
	in qaCatId  			{domain : DoId         		        cardinality : "1"  }
	in sequence  			{domain : DoNumber         		    cardinality : "1"  }
	out questionAnswer      {domain : DoDtQuestionAnswer        cardinality : "1"  }
}

create Task TkFindQueAnsNextNeighbor {
    className : "io.vertigo.basics.task.TaskEngineSelect"
    request : "
			SELECT 	qa.*
			from question_answer qa
			where qa.qa_cat_id = #qaCatId# and qa.sequence > #sequence#
			order by qa.sequence asc
			limit 1
             "
	in qaCatId  			{domain : DoId         		        cardinality : "1"  }
	in sequence  			{domain : DoNumber         		    cardinality : "1"  }
	out questionAnswer      {domain : DoDtQuestionAnswer        cardinality : "1"  }
}

create Task TkGetNextQueAnsSequence {
    className : "io.vertigo.basics.task.TaskEngineSelect"
    request : "
			select coalesce(max(sequence) + 1, 1)
			from question_answer qa
			where qa.qa_cat_id = #qaCatId#
             "
	in qaCatId  			          {domain : DoId         	cardinality : "1"  }
	out nextQueAnsSequence            {domain : DoNumber         cardinality : "1"  }
}

create Task TkReorderQueAnsAfterDelete {
    className : "io.vertigo.basics.task.TaskEngineProc"
    request : "
			update question_answer
			set sequence = (sequence - 1)
			where qa_cat_id = #qaCatId# and sequence > #deletedSequence#
             "
	in qaCatId  			          {domain : DoId         	cardinality : "1"  }
	in deletedSequence  			  {domain : DoNumber         cardinality : "1"  }
}