<?xml version="1.0" encoding="utf-8"?>

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet author="cmazereau" id="Add columns for tickets CHATBOT-682 and CHATBOT-699">
        <sqlFile encoding="utf8" path="/sql/v_3_0/alter_chatbot-682-699.sql" />
    </changeSet>

    <changeSet author="cmazereau"
        id="Remove and add columns for tickets CHATBOT-763 and CHATBOT-754">
        <sqlFile encoding="utf-8" path="/sql/v_3_0/alter_chatbot-763-754.sql" />
    </changeSet>

    <changeSet author="cmarechal"
               id="Mandatory fields for documentary and qa context CHATBOT-628">
        <sqlFile encoding="utf-8" path="/sql/v_3_0/alter_chatbot-628.sql" />
    </changeSet>

    <changeSet author="cmarechal"
               id="Remove and add columns on context environment table">
        <sqlFile encoding="utf-8" path="/sql/v_3_0/alter_chatbot-context-environment-values.sql" />
    </changeSet>

    <changeSet author="cmarechal"
               id="Add global variables for CHATBOT-779">
        <sqlFile encoding="utf-8" path="/sql/v_3_0/create_chatbot-779-global-variables.sql" />
    </changeSet>

    <changeSet author="cmarechal"
               id="Change welcome tour config">
        <sqlFile encoding="utf-8" path="/sql/v_3_0/alter_chatbot-welcome-tour.sql" />
    </changeSet>

    <changeSet author="xsupiot" id="Compute aggregated stats for documentary resource clicks">
        <customChange class="io.vertigo.chatbot.liquibase.InfluxDbFileMigration">
            <param name="file" value="/liquibase/changeLog/v_3_0/computeInfluxTaskStatsDocRes.flux"/>
        </customChange>
    </changeSet>

    <changeSet author="xsupiot" id="Add task to aggregate documentary resource click stats">
        <customChange class="io.vertigo.chatbot.liquibase.InfluxDbFileTask">
            <param name="file" value="/liquibase/changeLog/v_3_0/addInfluxTaskStatsDocRes.flux"/>
            <param name="name" value="aggregStatsDocRes"/>
            <param name="every" value="30s"/>
            <param name="offset" value="-20s"/>
        </customChange>
    </changeSet>

    <changeSet author="xsupiot" id="Add DOCUMENTARY_RESOURCES export type">
        <sqlFile encoding="utf8" path="/sql/v_3_0/alter_chatbot-822_26_01_15.sql"/>
    </changeSet>

    <changeSet author="xsupiot" id="Compute aggregated stats for Q&amp;A clicks">
        <customChange class="io.vertigo.chatbot.liquibase.InfluxDbFileMigration">
            <param name="file" value="/liquibase/changeLog/v_3_0/computeInfluxTaskStatsQA.flux"/>
        </customChange>
    </changeSet>

    <changeSet author="xsupiot" id="Add task to aggregate Q&amp;A click stats">
        <customChange class="io.vertigo.chatbot.liquibase.InfluxDbFileTask">
            <param name="file" value="/liquibase/changeLog/v_3_0/addInfluxTaskStatsQA.flux"/>
            <param name="name" value="aggregStatsQA"/>
            <param name="every" value="30s"/>
            <param name="offset" value="-20s"/>
        </customChange>
    </changeSet>

</databaseChangeLog>
